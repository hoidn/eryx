            'device': DEVICE
        }

        # Simulate with all sampled q-vectors and TRUE gamma
        # Use detached q-vectors as we don't need gradients w.r.t. q here
        model_ground_truth = OnePhonon(
            pdb_path=PDB_PATH,
            q_vectors=q_all_samples_tensor.clone().detach(),
