        ax3.set_xlabel("h", fontsize=12)
        ax3.set_ylabel("k", fontsize=12)
        ax3.set_zlabel("Intensity", fontsize=12)

        hklzone = hkl_grid_reshape[center[0]-hwidths[0]:center[0]+hwidths[0]+1,
