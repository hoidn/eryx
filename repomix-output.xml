    ylabel : str
        ylabel for leftmost plot, not used in plot_3d mode
    """
    if hkl_grid is None:
        if A_inv is None:
            raise ValueError("If hkl_grid is None, A_inv must be supplied.")
        hkl_grid, map_shape = generate_grid(A_inv, 
