            max_abs = torch.where(max_abs > 0, max_abs, torch.ones_like(max_abs))
            
            rel_error = abs_diff / max_abs
            
            # Compute statistics
            max_rel_error = rel_error.max().item()
            mean_rel_error = rel_error.mean().item()
            
