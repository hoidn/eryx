            "_gemmi_type": "Residue",
            "name": getattr(residue, "name", ""),
            "seqid_num": getattr(residue, "seqid", {}).num if hasattr(residue, "seqid") else 0,
            "seqid_icode": getattr(residue, "seqid", {}).icode if hasattr(residue, "seqid") else "",
            "atoms": []
        }
        
