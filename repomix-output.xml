        # 3. Models, Chains, Residues, Atoms
        models_list = []
        for model in structure:
            model_dict = self.serialize_model(model)
            models_list.append(model_dict)
        
        data["models"] = models_list
        
        return data

    def deserialize_structure(self, data: dict) -> gemmi.Structure:
