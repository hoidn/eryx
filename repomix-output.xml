    def serialize_model(self, model) -> dict:
        """
        Serialize a gemmi.Model to a dictionary.
        
        Args:
            model: gemmi.Model object
            
        Returns:
            Dictionary with serialized model data
        """
        result = {
            "_gemmi_type": "Model",
            "name": getattr(model, "name", ""),
            "chains": []
