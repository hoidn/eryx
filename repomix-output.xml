                        if tensor.dtype.is_floating_point:
                            tensor.requires_grad_(True)
                        setattr(obj, k, tensor)
                    continue
                
                # Handle direct NumPy arrays
                if isinstance(v, np.ndarray):
                    if k in ['q_grid', 'hkl_grid'] and self.grid_adapter:
